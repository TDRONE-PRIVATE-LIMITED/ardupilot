# hw definition file for the TDRONE power_board FMU (U12, STM32H743VIH6, TFBGA100)
# Pin map from the power_board netlist (U12 balls) joined with ST's CubeMX ball database.

MCU STM32H7xx STM32H743xx

# development ID, not registered with ArduPilot yet (see Tools/AP_Bootloader/board_types.txt)
APJ_BOARD_ID 7005

# Y1, 25 MHz HSE crystal
OSCILLATOR_HZ 25000000

FLASH_SIZE_KB 2048

# bootloader takes the first 128k sector
FLASH_RESERVE_START_KB 128

STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# parameters in internal flash (last two 128k sectors); FRAM IC2 on SPI4 is not used
define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

# no SWD on this board (PA13/PA14 unconnected)

# USB: OTG FS to the compute board over J1. No VBUS sense (PA9 is the BMS link).
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SERIAL0 USB (compute board)
# SERIAL1 UART4  ESC4 (U10 STM32G071) UART
# SERIAL2 UART7  radio 2 (U26 STM32WL55)
# SERIAL3 USART6 GPS (J21)
# SERIAL4 USART1 BMS (IC1 STM32U575, its USART3)
SERIAL_ORDER OTG1 UART4 UART7 USART6 USART1

# UART4 is also wired to radio 1 (PA0/PD0); ESC4 gets it, radio 1 is left unused for now
PC10 UART4_TX UART4
PC11 UART4_RX UART4

# SERIAL1 (ESC4): nothing by default, so MAVLink does not stream into the ESC
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_None

PB4 UART7_TX UART7
PB3 UART7_RX UART7

PC6 USART6_TX USART6
PC7 USART6_RX USART6

# PA9/PA10 is also the U12 ROM bootloader port, bridged by the BMS 'fmu' command
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# SERIAL4 (BMS link): MAVLink2 at 115200 instead of the GPS default
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL4_BAUD 115

# ESC1-3 UARTs (PB14/PB15, PD5/PD6, PD8/PD9) are not defined yet

# I2C1: 2x BMP581 + GPS compass (J21). I2C4: 10x VL53L5CX (J11-J20)
I2C_ORDER I2C1 I2C4
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1
PB6 I2C4_SCL I2C4
PB7 I2C4_SDA I2C4

define HAL_I2C_INTERNAL_MASK 0

# SPI1: IMU1 (U16 BMI088)
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PB5 SPI1_MOSI SPI1
PA4 BMI088_1_A_CS CS
PA3 BMI088_1_G_CS CS

# SPI2: IMU2 (U18 BMI088). PC2_C/PC3_C: analog switch resets closed on TFBGA100 (RM0433 SYSCFG_PMCR)
PD3 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC3 SPI2_MOSI SPI2
PD10 BMI088_2_A_CS CS
PD11 BMI088_2_G_CS CS

SPIDEV bmi088_1_a SPI1 DEVID1 BMI088_1_A_CS MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_1_g SPI1 DEVID2 BMI088_1_G_CS MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_2_a SPI2 DEVID1 BMI088_2_A_CS MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_2_g SPI2 DEVID2 BMI088_2_G_CS MODE3 10*MHZ 10*MHZ

DMA_NOSHARE SPI1* SPI2*

# orientation not yet checked against the board
IMU BMI088 SPI:bmi088_1_a SPI:bmi088_1_g ROTATION_NONE
IMU BMI088 SPI:bmi088_2_a SPI:bmi088_2_g ROTATION_NONE

# U15 SDO=3V3 -> 0x47, U17 SDO=GND -> 0x46
BARO BMP581 I2C:0:0x47
BARO BMP581 I2C:0:0x46

define ALLOW_ARM_NO_COMPASS
define AP_COMPASS_PROBING_ENABLED 1

# motors: 4x DShot to the AM32 ESCs (U4/U6/U8/U10)
PD12 TIM4_CH1 TIM4 PWM(1) GPIO(50)
PD13 TIM4_CH2 TIM4 PWM(2) GPIO(51)
PD14 TIM4_CH3 TIM4 PWM(3) GPIO(52)
PD15 TIM4_CH4 TIM4 PWM(4) GPIO(53)

# ESC BOOT0 (have pull-downs) and nRST (G071 internal pull-up): released by default
PE7  ESC1_BOOT0 OUTPUT LOW GPIO(60)
PE9  ESC2_BOOT0 OUTPUT LOW GPIO(61)
PE11 ESC3_BOOT0 OUTPUT LOW GPIO(62)
PE13 ESC4_BOOT0 OUTPUT LOW GPIO(63)
PE8  ESC1_NRST OUTPUT OPENDRAIN HIGH GPIO(64)
PE10 ESC2_NRST OUTPUT OPENDRAIN HIGH GPIO(65)
PE12 ESC3_NRST OUTPUT OPENDRAIN HIGH GPIO(66)
PE14 ESC4_NRST OUTPUT OPENDRAIN HIGH GPIO(67)

# VL53L5CX LPn: held low (I2C off) so ten sensors at 0x29 do not collide; no ArduPilot driver yet
PC13 PROX_LPN0 OUTPUT LOW GPIO(80)
PC12 PROX_LPN1 OUTPUT LOW GPIO(81)
PC8  PROX_LPN2 OUTPUT LOW GPIO(82)
PE0  PROX_LPN3 OUTPUT LOW GPIO(83)
PE1  PROX_LPN4 OUTPUT LOW GPIO(84)
PE3  PROX_LPN5 OUTPUT LOW GPIO(85)
PC15 PROX_LPN6 OUTPUT LOW GPIO(86)
PD7  PROX_LPN7 OUTPUT LOW GPIO(87)
PD1  PROX_LPN8 OUTPUT LOW GPIO(88)
PD2  PROX_LPN9 OUTPUT LOW GPIO(89)

# Ethernet (U14 ADIN1200, RMII, 50 MHz REF_CLK from PC9/MCO2) not enabled yet: PHY held in reset
PE15 PHY_NRST OUTPUT LOW GPIO(90)
PC0 PHY_INT INPUT

# analog
PB0 IMON_EFUSE ADC1 SCALE(1)

# battery data comes from the BMS, not from ADC
define HAL_BATT_MONITOR_DEFAULT 0

DMA_PRIORITY S*
